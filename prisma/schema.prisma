generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  brand String
  category String
  price Int
  salePrice Int?
  description String
  ingredients String
  howTo String
  volume String
  skinTypes String
  concerns String
  variants String
  stock Int @default(0)
  pao String
  rating Float @default(4.8)
  reviews String
  tags String
  image String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems OrderItem[]
  @@index([category])
  @@index([brand])
}
model Order {
  id String @id @default(cuid())
  code String @unique
  fullName String
  phone String
  email String?
  address String
  province String
  note String?
  payment String
  subtotal Int
  shipping Int
  discount Int
  total Int
  status String @default("PENDING")
  createdAt DateTime @default(now())
  items OrderItem[]
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  name String
  quantity Int
  unitPrice Int
  variant String?
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id])
  @@index([orderId])
}
model Subscriber {
  id String @id @default(cuid())
  email String @unique
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(cuid())
  fullName String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beautyProfile BeautyProfile?
}

model BeautyProfile {
  id String @id @default(cuid())
  userId String @unique
  skinType String
  concerns String @default("[]")
  sensitivity String @default("normal")
  goals String @default("")
  budget Int?
  preferences String @default("")
  consentAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([updatedAt])
}
